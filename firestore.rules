rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Chung =====
    function signedIn() { return request.auth != null; }
    function google() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    // Người chơi đăng nhập Zalo (máy chủ pikeco.app cấp tài khoản zalo_<id>)
    function zalo() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'custom' && request.auth.uid.matches('^zalo_[0-9A-Za-z]+$'); }
    // Người chơi: Zalo, hoặc tài khoản ẩn danh trên máy mình (chủ CLB duyệt từng người)
    function player() { return zalo() || (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'); }
    function rootEditor() { return signedIn() && exists(/databases/$(database)/documents/editors/$(request.auth.uid)); }
    // Quản trị nền tảng pikeco.app
    function isPA() {
      return google() && request.auth.token.email == 'phungthien244@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ===== Dữ liệu cũ (bản sao lưu) =====
    match /secret/{id} { allow read, write: if false; }
    match /editors/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'at'])
        && request.resource.data.pin == get(/databases/$(database)/documents/secret/pin).data.value;
      allow update, delete: if false;
    }
    match /app/{docId}     { allow read: if true; allow write: if rootEditor(); }
    match /players/{docId} { allow read: if true; allow write: if rootEditor(); }
    match /matches/{docId} { allow read: if true; allow write: if rootEditor(); }
    match /batches/{docId} { allow read: if true; allow write: if rootEditor(); }
    match /deleted/{docId} { allow read, write: if rootEditor(); }

    // Đăng nhập web bằng Zalo Mini App: máy chủ tạo và xoá mã (khoá dịch vụ). Ai có mã đọc được trạng thái;
    // Mini App đã đăng nhập Zalo chỉ được đồng ý cho chính tài khoản mình, hoặc từ chối, khi mã còn hạn.
    match /qrlogin/{tok} {
      allow get: if true;
      allow list, create, delete: if false;
      allow update: if zalo() && resource.data.st == 'wait' && resource.data.exp > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'uid', 'zn', 'okAt'])
        && ((request.resource.data.st == 'ok' && request.resource.data.uid == request.auth.uid) || (request.resource.data.st == 'no' && !('uid' in request.resource.data)))
        && request.resource.data.get('zn', '') is string && request.resource.data.get('zn', '').size() <= 40;
    }

    // ===== Nền tảng =====
    // Mỗi tài khoản (Google hoặc Zalo) một CLB: users/{uid} = { club, at }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPA();
      allow create: if (google() || zalo()) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['club', 'at'])
        && request.resource.data.club is string
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.club)).data.owner == uid;
      allow update: if false;
      allow delete: if isPA();
    }

    // Mã mời tạo CLB (dùng một lần)
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if isPA() && request.resource.data.used == false;
      allow delete: if isPA();
      allow update: if isPA() || (
        (google() || zalo()) && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'club', 'by', 'at'])
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.club)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.club)).data.code == code
      );
    }

    // Cài đặt nền tảng (EmailJS: service/template/public key là khoá công khai)
    match /platform/{doc} {
      allow read: if true;
      allow write: if isPA();
    }

    // ===== Mỗi CLB một không gian riêng =====
    match /clubs/{c} {
      function clubDoc() { return get(/databases/$(database)/documents/clubs/$(c)).data; }
      function memberPath(uid) { return /databases/$(database)/documents/clubs/$(c)/members/$(uid); }
      function isMember() { return signedIn() && exists(memberPath(request.auth.uid)); }
      function myRole() { return get(memberPath(request.auth.uid)).data.role; }
      function isAdmin() { return isMember() && myRole() in ['owner', 'admin']; }
      function isPinEditor() { return signedIn() && exists(/databases/$(database)/documents/clubs/$(c)/editors/$(request.auth.uid)); }
      function active() { return clubDoc().get('status', 'active') == 'active'; }
      // Chủ CLB và quản lý: sửa mọi thứ. Trọng tài (tài khoản Trọng tài hoặc máy PIN): chỉ nhập tỉ số sân được giao.
      function canEdit() { return active() && isAdmin(); }
      function myLinkOk() { return signedIn() && exists(/databases/$(database)/documents/clubs/$(c)/links/$(request.auth.uid)) && get(/databases/$(database)/documents/clubs/$(c)/links/$(request.auth.uid)).data.status == 'ok'; }
      function refCourts() {
        return isMember() ? get(memberPath(request.auth.uid)).data.get('courts', [])
          : get(/databases/$(database)/documents/clubs/$(c)/editors/$(request.auth.uid)).data.get('courts', []);
      }
      function qrRef() { return signedIn() && exists(/databases/$(database)/documents/clubs/$(c)/refs/$(request.auth.uid)); }
      function scoreOk() {
        return active()
          && (((isMember() || isPinEditor()) && resource.data.court in refCourts())
              || (qrRef() && get(/databases/$(database)/documents/clubs/$(c)/refs/$(request.auth.uid)).data.court == resource.data.court))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sa', 'sb', 'status', 'doneAt', 'ref']);
      }
      function canRead() { return (active() && clubDoc().public == true) || isMember() || isPinEditor() || isPA() || qrRef(); }

      function newClubOk() {
        let d = request.resource.data;
        let me = request.auth.uid;
        return c.matches('^[a-z0-9][a-z0-9-]{1,18}[a-z0-9]$')
          && !(c in ['aep', 'admin', 'www', 'quantri', 'tao', 'start', 'api', 'app', 'pikeco', 'clb', 'login', 'help',
                  'tao-clb', 'dang-nhap', 'quan-tri', 'cai-dat', 'assets', 'moi', 'buoi'])
          && d.keys().hasOnly(['name', 'public', 'owner', 'status', 'city', 'size', 'createdAt', 'code'])
          && d.name is string && d.name.size() >= 3 && d.name.size() <= 60
          && d.public == true
          && !exists(/databases/$(database)/documents/users/$(me))
          && getAfter(/databases/$(database)/documents/users/$(me)).data.club == c
          && (d.status == 'pending'
              || (d.status == 'active' && d.code is string
                  && get(/databases/$(database)/documents/codes/$(d.code)).data.used == false
                  && getAfter(/databases/$(database)/documents/codes/$(d.code)).data.club == c));
      }

      // Tên CLB, ngân hàng nhận tiền, trạng thái: ai cũng đọc được
      allow read: if true;
      allow create: if (google() || zalo()) && request.resource.data.owner == request.auth.uid && (
          newClubOk()
          // Đường cũ: chuyển CLB AEP từ dữ liệu PIN chung
          || (rootEditor() && request.resource.data.keys().hasOnly(['name', 'public', 'owner', 'bank', 'createdAt']))
        );
      allow update: if (isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'status', 'statusNote', 'reviewedAt', 'createdAt', 'code']))
        || (isPA()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusNote', 'reviewedAt'])
          && request.resource.data.status in ['pending', 'active', 'locked', 'rejected']);
      allow delete: if false;

      // Liên hệ của chủ CLB: chỉ quản trị nền tảng và ban quản lý CLB xem
      match /private/{doc} {
        allow read: if isPA() || isAdmin();
        allow create: if (google() || zalo()) && doc == 'info'
          && getAfter(/databases/$(database)/documents/clubs/$(c)).data.owner == request.auth.uid
          && !exists(/databases/$(database)/documents/clubs/$(c))
          && request.resource.data.keys().hasOnly(['contact', 'ownerEmail']);
        allow update: if isAdmin() && request.resource.data.keys().hasOnly(['contact', 'ownerEmail']);
        allow delete: if false;
      }

      match /members/{uid} {
        allow read: if isMember() || (signedIn() && request.auth.uid == uid) || isPA();
        // Chủ CLB: Google. Quản lý/trọng tài nhận link mời bằng Google (web) hoặc Zalo (Mini App)
        allow create: if (request.auth.uid == uid && (
            ((google() || zalo()) && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/clubs/$(c)).data.owner == uid)
            // Chủ CLB liên kết tài khoản thứ hai (Google ↔ Zalo) bằng link mời chủ CLB, hiệu lực ngắn
            || ((google() || zalo()) && request.resource.data.role == 'owner'
                && request.resource.data.invite is string
                && get(/databases/$(database)/documents/clubs/$(c)/invites/$(request.resource.data.invite)).data.role == 'owner'
                && get(/databases/$(database)/documents/clubs/$(c)/invites/$(request.resource.data.invite)).data.exp > request.time.toMillis())
            || ((google() || zalo()) && request.resource.data.role in ['admin', 'scorer']
                && request.resource.data.invite is string
                && get(/databases/$(database)/documents/clubs/$(c)/invites/$(request.resource.data.invite)).data.role == request.resource.data.role
                && get(/databases/$(database)/documents/clubs/$(c)/invites/$(request.resource.data.invite)).data.exp > request.time.toMillis())
          ))
          // Ban tổ chức giao quyền thẳng cho người chơi đã liên kết Zalo (trang Thành viên)
          || (isAdmin() && request.resource.data.role in ['admin', 'scorer']
              && request.resource.data.keys().hasOnly(['role', 'name', 'via', 'pid', 'at', 'by'])
              && get(/databases/$(database)/documents/clubs/$(c)/links/$(uid)).data.status == 'ok');
        allow update: if isAdmin() && resource.data.role != 'owner' && request.resource.data.role in ['admin', 'scorer'];
        allow delete: if (resource.data.role != 'owner' && (isAdmin() || (signedIn() && request.auth.uid == uid)))
          // Tài khoản chủ CLB thứ hai (đã liên kết): chủ CLB gỡ được, trừ tài khoản chủ chính
          || (resource.data.role == 'owner' && uid != clubDoc().owner && isMember() && myRole() == 'owner');
      }

      match /invites/{tok} {
        // Chỉ đọc đúng mã mời mình có (không liệt kê được cả danh sách mã mời)
        allow get: if signedIn();
        allow list: if isAdmin();
        allow create: if (isAdmin() && request.resource.data.role in ['admin', 'scorer'])
          // Link liên kết tài khoản của chính chủ CLB: chỉ chủ CLB tạo, hết hạn trong 15 phút
          || (isMember() && myRole() == 'owner' && request.resource.data.role == 'owner'
              && request.resource.data.exp <= request.time.toMillis() + 900000);
        allow delete: if isAdmin();
        allow update: if false;
      }

      // PIN trọng tài: chỉ Rules đọc được, quản lý được đặt lại
      match /secret/{id} {
        allow read: if false;
        allow write: if isAdmin();
      }

      match /editors/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['pin', 'at', 'name'])
          && request.resource.data.pin == get(/databases/$(database)/documents/clubs/$(c)/secret/pin).data.value;
        allow delete: if isAdmin();
        // Ban tổ chức giao sân cho máy PIN
        allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courts']);
      }

      // Dữ liệu buổi đánh: CLB phải đang hoạt động mới ghi được
      match /app/{docId}     { allow read: if canRead(); allow write: if canEdit(); }
      match /players/{docId} {
        allow read: if canRead();
        allow write: if canEdit();
        // Người chơi đã được duyệt tự sửa hồ sơ của mình: ảnh, biệt danh, giới thiệu, tay thuận, vợt, năm bắt đầu chơi
        allow update: if active() && player()
          && get(/databases/$(database)/documents/clubs/$(c)/links/$(request.auth.uid)).data.status == 'ok'
          && get(/databases/$(database)/documents/clubs/$(c)/links/$(request.auth.uid)).data.pid == docId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'nick', 'bio', 'hand', 'paddle', 'since'])
          && request.resource.data.get('photo', '').size() < 60000
          && request.resource.data.get('bio', '').size() <= 300
          && request.resource.data.get('nick', '').size() <= 30
          && request.resource.data.get('paddle', '').size() <= 60;
      }
      match /matches/{docId} { allow read: if canRead(); allow write: if canEdit(); allow update: if scoreOk(); }
      // Buổi đã xóa: chỉ chủ CLB khôi phục
      match /deleted/{docId} {
        allow read: if isAdmin();
        allow create: if canEdit();
        allow delete: if isMember() && myRole() == 'owner';
      }
      match /batches/{docId} { allow read: if canRead(); allow write: if canEdit(); }
      // Ảnh thẻ chia sẻ (JPEG vẽ trên máy người chia sẻ) và poster giải: ai xem được CLB thì xem được ảnh
      // Ghi: ban tổ chức; người chơi đã được duyệt ghi ảnh hồ sơ/giải/tổng kết/sân/CLB (không ghi poster)
      match /the/{key} {
        allow read: if canRead();
        allow delete: if canEdit();
        allow create, update: if key.matches('^[a-z-]+(_[A-Za-z0-9_-]{1,80})?$')
          && request.resource.data.keys().hasOnly(['img', 'at'])
          && request.resource.data.img is string && request.resource.data.img.size() < 400000
          && request.resource.data.img[0:23] == 'data:image/jpeg;base64,'
          && (canEdit() || (active() && player() && !key.matches('^poster_.*') && myLinkOk()));
      }
      // Ghi chú nội bộ về thành viên: chỉ chủ CLB và quản lý
      match /notes/{pid} {
        allow read, delete: if isAdmin();
        allow write: if isAdmin() && request.resource.data.keys().hasOnly(['t', 'at', 'by']) && request.resource.data.t is string && request.resource.data.t.size() <= 500;
      }

      // Số điện thoại người chơi: chỉ chính người đó và chủ CLB, quản lý đọc
      match /contacts/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create, update: if active() && signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['phone', 'at', 'src'])
          && request.resource.data.phone is string && request.resource.data.phone.matches('^0[0-9]{9}$')
          && request.resource.data.get('src', 'tay') in ['zalo', 'tay'];
        allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }

      // Người chơi Zalo xin nhận hồ sơ VĐV, chủ CLB hoặc quản lý duyệt
      match /links/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if active() && player() && request.auth.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['status', 'zname', 'photo', 'at', 'pid', 'newName', 'gender', 'zid'])
          && request.resource.data.get('zid', '') is string && request.resource.data.get('zid', '').size() <= 64;
        // Mã chat Zalo của chính mình (ban tổ chức dùng để nhắn tin)
        allow update: if canEdit() || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zid'])
          && request.resource.data.zid is string && request.resource.data.zid.size() <= 64);
        allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }

      // Lịch buổi: nhiều buổi sắp tới, mỗi buổi một tài liệu; lịch lặp hằng tuần
      match /sched/{x} {
        allow read: if canRead();
        allow write: if canEdit();
      }
      match /series/{x} {
        allow read: if canRead();
        allow write: if canEdit();
      }

      // Đăng ký buổi: người chơi đã được duyệt tự đăng ký, tự hủy trước giờ khóa hủy
      // sid là số: buổi hiện tại (cách cũ, app/config.reg). sid là chuỗi: một buổi trong lịch (sched/{sid}).
      function cfgDoc() { return get(/databases/$(database)/documents/clubs/$(c)/app/config).data; }
      function myLink() { return get(/databases/$(database)/documents/clubs/$(c)/links/$(request.auth.uid)).data; }
      function sx(s) { return get(/databases/$(database)/documents/clubs/$(c)/sched/$(s)).data; }
      // Buổi đang nhận đăng ký: mở tay, hoặc tự mở khi tới giờ
      function sxOpen(s) {
        let d = sx(s);
        return (d.get('st', '') == 'open'
            || (d.get('st', '') == 'plan' && d.get('openAt', 0) > 0 && request.time.toMillis() >= d.get('openAt', 0)))
          && (d.get('deadline', 0) == 0 || request.time.toMillis() < d.get('deadline', 0));
      }
      function regRules() { return request.resource.data.sid is int ? cfgDoc().get('reg', {}) : sx(request.resource.data.sid); }
      function lockOf(sid) { return sid is int ? cfgDoc().get('reg', {}).get('lockAt', 0) : sx(sid).get('lockAt', 0); }
      match /regs/{id} {
        allow read: if canRead();
        allow create: if canEdit() || (
          active() && player()
          && request.resource.data.keys().hasOnly(['sid', 'uid', 'pid', 'name', 'at', 'pay', 'guest', 'gender', 'lv', 'hold', 'team', 'want', 'wantName', 'seek', 'zid'])
          && request.resource.data.get('zid', '') is string && request.resource.data.get('zid', '').size() <= 64
          && request.resource.data.get('hold', false) is bool
          && request.resource.data.get('seek', false) is bool
          && request.resource.data.get('team', '') is string && request.resource.data.get('team', '').size() <= 120
          && request.resource.data.get('want', '') is string && request.resource.data.get('want', '').size() <= 60
          && request.resource.data.get('wantName', '') is string && request.resource.data.get('wantName', '').size() <= 60
          && request.resource.data.uid == request.auth.uid
          && id == string(request.resource.data.sid) + '_' + request.auth.uid
          && request.resource.data.get('pay', 'none') in ['none', 'sent']
          && (
            (request.resource.data.sid is int
              && cfgDoc().get('reg', {}).get('on', false) == true
              && request.resource.data.sid == cfgDoc().get('session', 1)
              && (cfgDoc().get('reg', {}).get('deadline', 0) == 0
                  || request.time.toMillis() < cfgDoc().get('reg', {}).get('deadline', 0)))
            || (request.resource.data.sid is string
              && exists(/databases/$(database)/documents/clubs/$(c)/sched/$(request.resource.data.sid))
              && sxOpen(request.resource.data.sid))
          )
          && (
            (myLink().status == 'ok' && myLink().pid == request.resource.data.pid
              && request.resource.data.get('guest', false) == false)
            || (regRules().get('guests', false) == true
              && request.resource.data.get('guest', false) == true
              && request.resource.data.get('pid', null) == null
              && request.resource.data.name is string && request.resource.data.name.size() > 0)
          )
        );
        // Vãng lai / đến muộn chưa đăng ký: xin vào bằng mã check-in đang hiện trên máy BTC (phải có mặt ở sân),
        // không cần giải còn mở đăng ký; BTC duyệt tại bàn. Giải tắt nhận vãng lai (walkin == false) thì không.
        allow create: if active() && player()
          && request.resource.data.keys().hasOnly(['sid', 'uid', 'pid', 'name', 'at', 'pay', 'guest', 'gender', 'lv', 'zid', 'walkin', 'ci', 'ciCode'])
          && request.resource.data.sid is string
          && request.resource.data.uid == request.auth.uid
          && id == request.resource.data.sid + '_' + request.auth.uid
          && request.resource.data.walkin == true
          && request.resource.data.get('pay', 'none') == 'none'
          && request.resource.data.get('zid', '') is string && request.resource.data.get('zid', '').size() <= 64
          && exists(/databases/$(database)/documents/clubs/$(c)/sched/$(request.resource.data.sid))
          && sx(request.resource.data.sid).get('walkin', true) != false
          && request.resource.data.ci is int
          && request.resource.data.ciCode is string && request.resource.data.ciCode.size() > 0
          && request.resource.data.ciCode == get(/databases/$(database)/documents/clubs/$(c)/ci/$(request.resource.data.sid)).data.code
          && request.time.toMillis() < get(/databases/$(database)/documents/clubs/$(c)/ci/$(request.resource.data.sid)).data.exp
          && (
            (myLink().status == 'ok' && myLink().pid == request.resource.data.pid
              && request.resource.data.get('guest', false) == false)
            || (request.resource.data.get('guest', false) == true
              && request.resource.data.get('pid', null) == null
              && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60)
          );
        // Check-in: người chơi quét mã đang hiện trên máy ban tổ chức (mã đổi liên tục, có hạn)
        function ciOk() {
          let k = get(/databases/$(database)/documents/clubs/$(c)/ci/$(string(resource.data.sid))).data;
          return request.resource.data.ciCode == k.code && request.time.toMillis() < k.exp
            && request.resource.data.ci is int;
        }
        // Người chơi: báo đã chuyển khoản (chưa trả → đã chuyển), đổi sang trả tại sân, check-in, hoặc hủy trước giờ khóa hủy
        function beforeLock() {
          return lockOf(resource.data.sid) == 0 || request.time.toMillis() < lockOf(resource.data.sid);
        }
        allow update: if canEdit() || (
          player() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pay', 'paidAt', 'cancel', 'cancelAt', 'hold', 'ci', 'ciCode'])
          && (!('hold' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.hold == false)
          && (!('ci' in request.resource.data.diff(resource.data).affectedKeys()) || ciOk())
          && (request.resource.data.get('pay', 'none') == resource.data.get('pay', 'none')
              || (resource.data.get('pay', 'none') == 'none' && request.resource.data.get('pay', 'none') == 'sent'))
          && (!('cancel' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.cancel == true && beforeLock()))
        );
        allow delete: if canEdit() || (
          player() && resource.data.uid == request.auth.uid && beforeLock()
        );
      }
      // Mã check-in đang hiện trên máy ban tổ chức: chỉ ban tổ chức đọc, ghi
      match /ci/{sid} {
        allow read, write: if canEdit();
      }
      // Mã QR trọng tài từng sân: chỉ ban tổ chức đọc, ghi
      match /refqr/{court} {
        allow read, write: if canEdit();
      }
      // Trọng tài nhận sân bằng QR: tự ghi hồ sơ của mình khi mã khớp mã BTC đang dùng cho sân đó
      match /refs/{uid} {
        allow read: if canRead() || (signedIn() && request.auth.uid == uid);
        allow create, update: if active() && signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['court', 'code', 'name', 'at', 'sid'])
          && request.resource.data.court is int
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && exists(/databases/$(database)/documents/clubs/$(c)/refqr/$(string(request.resource.data.court)))
          && get(/databases/$(database)/documents/clubs/$(c)/refqr/$(string(request.resource.data.court))).data.code == request.resource.data.code;
        allow delete: if canEdit() || (signedIn() && request.auth.uid == uid);
      }
      // Yêu cầu gọi loa / gọi BTC từ trọng tài và BTC
      match /calls/{id} {
        allow read: if canEdit() || qrRef() || isMember() || isPinEditor();
        allow create: if active() && signedIn() && (canEdit() || isMember() || isPinEditor() || qrRef())
          && request.resource.data.keys().hasOnly(['k', 'court', 'txt', 'why', 'by', 'uid', 'at', 'sid', 'st'])
          && request.resource.data.k in ['loa', 'btc'] && request.resource.data.st == 'new'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.get('txt', '') is string && request.resource.data.get('txt', '').size() <= 400;
        allow update, delete: if canEdit();
      }
      // Ảnh của VĐV ngoài CLB lúc đăng ký: chỉ ban tổ chức và chính người đó xem
      match /regpics/{id} {
        allow read: if isAdmin() || isPA() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['img', 'uid', 'at'])
          && request.resource.data.img is string && request.resource.data.img.size() < 120000
          && get(/databases/$(database)/documents/clubs/$(c)/regs/$(id)).data.uid == request.auth.uid;
        allow delete: if canEdit() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
